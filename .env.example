# Telegram Bot Token (من BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# معرّفات الجروبات المسموح بها (فاصل بينها فاصلة)
# اتركها فارغة إذا كنت تريد قبول أي جروب
ALLOWED_CHAT_IDS=-1001234567890,-1009876543210

# مستوى السجل (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# مهلة Polling (بالثواني)
POLLING_TIMEOUT=30

# مهلة القراءة (بالثواني)
READ_TIMEOUT=60

# عتبة ثقة OCR (0.0 - 1.0)
OCR_CONFIDENCE_THRESHOLD=0.3
